{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.radioretail/streaming/device-event.schema.json",
  "title": "Device presence event",
  "description": "streams.device.connected / streams.device.disconnected envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "timestamp", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": ["streams.device.connected", "streams.device.disconnected"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "device_id", "occurred_at"],
      "properties": {
        "store_id": { "type": "string", "format": "uuid" },
        "device_id": { "type": "string", "format": "uuid" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "enum": ["graceful", "timeout"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "streams.device.disconnected" } } },
      "then": { "properties": { "payload": { "required": ["store_id", "device_id", "occurred_at", "reason"] } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "streams.device.connected" } } },
      "then": { "properties": { "payload": { "not": { "required": ["reason"] } } } }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.radioretail.co.za/hourplan/1.0/hourplan.schema.json",
  "title": "HourPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "store_id", "hour_bucket", "timezone",
    "format_clock_id", "format_clock_version", "schedule_revision",
    "compiled_at", "total_duration_ms", "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "$comment": "major.minor only — patch bumps are docs/fixtures with no wire change, so plans never carry a patch component."
    },
    "store_id": { "type": "string", "format": "uuid" },
    "hour_bucket": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1 },
    "format_clock_id": { "type": "string", "format": "uuid" },
    "format_clock_version": { "type": "integer", "minimum": 1 },
    "schedule_revision": { "type": "string", "minLength": 1 },
    "compiled_at": { "type": "string", "format": "date-time" },
    "total_duration_ms": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planItem" }
    }
  },
  "$defs": {
    "scheduleRef": {
      "$comment": "Nullable: required/properties only constrain objects, so null passes and a malformed object reports the exact field.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" }
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "family", "media_id", "uri", "duration_ms", "timing_rule"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "family": { "type": "string", "minLength": 1 },
        "media_id": { "type": "string", "format": "uuid" },
        "uri": { "type": "string", "pattern": "^s3://" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "timing_rule": { "enum": ["soft", "hard"] },
        "start_offset_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 3599999 },
        "schedule": {
          "$comment": "Added in 1.3.0. The placing schedule: the PRC-/MESC- schedule whose table slot put this item into the plan. Optional and nullable; soft items carry null. No invariant requires it on hard items.",
          "$ref": "#/$defs/scheduleRef"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "timing_rule": { "const": "hard" } } },
          "then": {
            "required": ["start_offset_ms"],
            "properties": { "start_offset_ms": { "type": "integer", "minimum": 0, "maximum": 3599999 } }
          }
        },
        {
          "if": { "properties": { "timing_rule": { "const": "soft" } } },
          "then": { "properties": { "start_offset_ms": { "type": "null" } } }
        }
      ]
    }
  }
}

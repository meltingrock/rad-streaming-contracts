{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.radioretail/streaming/channel-event.schema.json",
  "title": "Channel event",
  "description": "playout.channel.* envelope: one timestamped fact reported by a store's channel in the stream worker. The raw material as-run entries are assembled from. Added in 1.3.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "timestamp", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "$comment": "uuid5(channel_instance_id, seq): stable across redelivery and republish; consumers dedupe on it."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "playout.channel.started",
        "playout.channel.ended",
        "playout.channel.skip_requested",
        "playout.channel.flushed",
        "playout.channel.went_silent",
        "playout.channel.gap"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "$comment": "Publish time. Never air time: that is payload.occurred_at."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "channel_instance_id", "seq", "occurred_at"],
      "properties": {
        "store_id": { "type": "string", "format": "uuid" },
        "channel_instance_id": {
          "type": "string",
          "format": "uuid",
          "$comment": "Generated by the sidecar each time it creates the channel."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Per channel instance, from 0, in the order the channel recorded events."
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "$comment": "When the channel recorded the fact (Liquidsoap clock at the hook or verb handler)."
        },
        "rid": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Liquidsoap request id. Unique within one Liquidsoap process only; pair with channel_instance_id."
        },
        "item": { "$ref": "#/$defs/item" },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "crossfade_ms": { "type": "integer", "minimum": 0 },
        "dropped_count": { "type": "integer", "minimum": 1 },
        "first_seq": { "type": "integer", "minimum": 0 },
        "last_seq": { "type": "integer", "minimum": 0 },
        "dropped_from_at": { "type": "string", "format": "date-time" },
        "dropped_to_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "playout.channel.started" } } },
      "then": { "properties": { "payload": {
        "required": ["rid", "item", "crossfade_ms"],
        "not": { "anyOf": [ { "required": ["elapsed_ms"] }, { "$ref": "#/$defs/hasGapFields" } ] }
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "playout.channel.ended" } } },
      "then": { "properties": { "payload": {
        "required": ["rid", "item", "elapsed_ms"],
        "not": { "anyOf": [ { "required": ["crossfade_ms"] }, { "$ref": "#/$defs/hasGapFields" } ] }
      } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["playout.channel.skip_requested", "playout.channel.flushed"] } } },
      "then": { "properties": { "payload": {
        "required": ["rid", "item"],
        "not": { "anyOf": [ { "required": ["elapsed_ms"] }, { "required": ["crossfade_ms"] }, { "$ref": "#/$defs/hasGapFields" } ] }
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "playout.channel.went_silent" } } },
      "then": { "properties": { "payload": {
        "not": { "anyOf": [ { "$ref": "#/$defs/hasItemFields" }, { "$ref": "#/$defs/hasGapFields" } ] }
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "playout.channel.gap" } } },
      "then": { "properties": { "payload": {
        "required": ["dropped_count", "first_seq", "last_seq", "dropped_from_at", "dropped_to_at"],
        "not": { "$ref": "#/$defs/hasItemFields" }
      } } }
    }
  ],
  "$defs": {
    "hasItemFields": {
      "anyOf": [
        { "required": ["rid"] }, { "required": ["item"] },
        { "required": ["elapsed_ms"] }, { "required": ["crossfade_ms"] }
      ]
    },
    "hasGapFields": {
      "anyOf": [
        { "required": ["dropped_count"] }, { "required": ["first_seq"] }, { "required": ["last_seq"] },
        { "required": ["dropped_from_at"] }, { "required": ["dropped_to_at"] }
      ]
    },
    "scheduleRef": {
      "$comment": "Nullable: required/properties only constrain objects, so null passes and a malformed object reports the exact field.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" }
      }
    },
    "item": {
      "$comment": "The plan item this request was pushed for, carried as request annotations by the player. Mirrors HourPlan planItem plus the plan-level fields an as-run entry needs; no uri.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id", "seq", "family", "hour_bucket", "schedule_revision",
        "format_clock_version", "timezone", "duration_ms", "timing_rule"
      ],
      "properties": {
        "media_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 0 },
        "family": { "type": "string", "minLength": 1 },
        "hour_bucket": { "type": "string", "format": "date-time" },
        "schedule_revision": { "type": "string", "minLength": 1 },
        "format_clock_version": { "type": "integer", "minimum": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "timing_rule": { "enum": ["soft", "hard"] },
        "start_offset_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 3599999 },
        "schedule": { "$ref": "#/$defs/scheduleRef" }
      },
      "allOf": [
        {
          "if": { "properties": { "timing_rule": { "const": "hard" } } },
          "then": {
            "required": ["start_offset_ms"],
            "properties": { "start_offset_ms": { "type": "integer", "minimum": 0, "maximum": 3599999 } }
          }
        },
        {
          "if": { "properties": { "timing_rule": { "const": "soft" } } },
          "then": { "properties": { "start_offset_ms": { "type": "null" } } }
        }
      ]
    }
  }
}
